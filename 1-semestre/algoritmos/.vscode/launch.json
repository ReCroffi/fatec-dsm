{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C: debug arquivo atual (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${fileDirname}",
      "stopAtEntry": false,
      "environment": [],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "C: compilar arquivo atual",
      "console": "integratedTerminal",
      "setupCommands": [
        {
          "description": "formatacao legivel de structs/arrays no gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
